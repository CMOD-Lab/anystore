<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- .NET 8: supportedRuntime element is not used for .NET Core/.NET 5+ applications -->
  <!-- Runtime is determined by the TargetFramework in the .csproj file (net8.0-windows) -->

  <connectionStrings>
    <add name="connstrng" connectionString="Data Source=(local);Initial Catalog=AnyStore;Integrated Security=True;TrustServerCertificate=True" />
  </connectionStrings>
</configuration>
