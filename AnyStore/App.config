<?xml version="1.0" encoding="utf-8" ?>
<!--
  App.config for AnyStore .NET 8 Windows Forms Application
  Updated for PostgreSQL 16 compatibility:
  - Replaced SQL Server connection string with PostgreSQL (Npgsql) format
  - Host=localhost; Database=AnyStore; Username/Password for PostgreSQL authentication
  - Removed TrustServerCertificate (SQL Server specific)
  - providerName updated to Npgsql
-->
<configuration>
  <connectionStrings>
    <add name="connstrng"
         connectionString="Host=localhost;Port=5432;Database=AnyStore;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Connection Lifetime=300;"
         providerName="Npgsql" />
  </connectionStrings>
</configuration>
