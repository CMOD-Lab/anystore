<?xml version="1.0" encoding="utf-8" ?>
<!--
  App.config for AnyStore .NET 8 Windows Forms Application
  Updated for .NET 8 compatibility:
  - Removed legacy <startup> / supportedRuntime elements (not needed in .NET 8)
  - Retained connectionStrings section for database connectivity
  - TrustServerCertificate=True is required for Microsoft.Data.SqlClient 4.x+
-->
<configuration>
  <connectionStrings>
    <add name="connstrng"
         connectionString="Data Source=(local);Initial Catalog=AnyStore;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
