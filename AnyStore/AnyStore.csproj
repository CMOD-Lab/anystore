<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AnyStore</RootNamespace>
    <AssemblyName>AnyStore</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <!-- Suppress nullable warnings for legacy code patterns -->
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient replaces System.Data.SqlClient for .NET 8 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
    <!-- System.Configuration.ConfigurationManager for ConfigurationManager support in .NET 8 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <!-- System.Transactions.Local for TransactionScope support in .NET 8 -->
    <PackageReference Include="System.Transactions.Local" Version="8.0.0" />
  </ItemGroup>

</Project>
