<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Updated from v4.5.2 to net8.0-windows for .NET 8 upgrade -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AnyStore</RootNamespace>
    <AssemblyName>AnyStore</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Nullable reference types enabled for .NET 8 best practices -->
    <Nullable>enable</Nullable>
    <!-- ImplicitUsings enabled for .NET 8 conventions -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon />
    <StartupObject />
    <!-- Assembly metadata for .NET 8 SDK-style project -->
    <AssemblyTitle>AnyStore</AssemblyTitle>
    <AssemblyDescription></AssemblyDescription>
    <Company></Company>
    <Product>AnyStore</Product>
    <Copyright>Copyright © 2017</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Suppress warnings for legacy code patterns during migration -->
    <NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0618;CS1591</NoWarn>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient replaces deprecated System.Data.SqlClient for .NET 8 compatibility -->
    <!-- Npgsql replaces Microsoft.Data.SqlClient for PostgreSQL 16 compatibility -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <!-- System.Configuration.ConfigurationManager provides ConfigurationManager support in .NET 8 -->
