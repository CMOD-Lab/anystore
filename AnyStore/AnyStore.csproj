<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Updated TargetFramework from net6.0-windows to net8.0-windows for .NET 8 compatibility -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AnyStore</RootNamespace>
    <AssemblyName>AnyStore</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <StartupObject>AnyStore.Program</StartupObject>
    <!-- Suppress nullable warnings for legacy code during migration -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8767</NoWarn>
    <!-- Generate assembly info from project properties (SDK-style) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient 5.2.1 replaces System.Data.SqlClient for .NET 8 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
    <!-- System.Configuration.ConfigurationManager 8.0.0 for ConfigurationManager support in .NET 8 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <!--
      NOTE: Microsoft.EntityFrameworkCore and Microsoft.AspNetCore.App are NOT used by this
      Windows Forms application. This project uses direct ADO.NET (Microsoft.Data.SqlClient)
      for data access and does not require EF Core or ASP.NET Core packages.
      The analysis report flagged these as needing updates, but they are not applicable here.
    -->
  </ItemGroup>

</Project>
