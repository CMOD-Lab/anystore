<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Updated TargetFramework to net8.0-windows for .NET 8 compatibility -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AnyStore</RootNamespace>
    <AssemblyName>AnyStore</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <StartupObject>AnyStore.Program</StartupObject>
    <!-- Suppress nullable warnings for legacy code during migration -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8767</NoWarn>
    <!-- Generate assembly info from project properties (SDK-style) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Npgsql 8.0.5: PostgreSQL ADO.NET data provider replacing Microsoft.Data.SqlClient -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <!-- System.Configuration.ConfigurationManager 8.0.0 for ConfigurationManager support in .NET 8 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
