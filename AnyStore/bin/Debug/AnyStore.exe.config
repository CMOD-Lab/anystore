<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- .NET 8: supportedRuntime element is not used for .NET Core/.NET 5+ applications -->
  <!-- Runtime is determined by the TargetFramework in the .csproj file (net8.0-windows) -->

  <connectionStrings>
    <!-- Converted from SQL Server to PostgreSQL 16 connection string format -->
    <add name="connstrng" connectionString="Host=localhost;Port=5432;Database=AnyStore;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Connection Idle Lifetime=300;Command Timeout=30;" />
  </connectionStrings>
</configuration>
